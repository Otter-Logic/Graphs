<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OtterLogic.Graphs.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Only Rhino ships a .NET 7 runtime; roll forward so `dotnet test` works
         against whatever is installed. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- No RhinoCommon and no Rhino.Inside. Graph algorithms are pure
         arithmetic, so these run anywhere - including a hosted CI runner with
         no Rhino and no licence. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <ProjectReference Include="..\..\src\OtterLogic.Graphs\OtterLogic.Graphs.csproj" />
  </ItemGroup>

</Project>
